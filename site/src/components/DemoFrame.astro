---
import Shot from "./Shot.astro";

interface Props {
  src: string;
  label: string;
  fallback: string;
}

// The tutorial is desktop-first: render it at a desktop size and scale it down to fit.
// Narrow screens get a screenshot that opens the tutorial instead.
const { src, label, fallback } = Astro.props;
---

<div class="browser" data-demo>
  <div class="chrome">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="url">{label}</span>
    <a class="open" href={src} target="_blank" rel="noopener">Open full screen ↗</a>
  </div>
  <div class="viewport">
    <iframe src={src} title="Live tutorial demo" loading="lazy"></iframe>
  </div>
  <a class="fallback" href={src}>
    <Shot name={fallback} alt="The embedded tutorial. Tap to open it." />
  </a>
</div>

<style>
  .browser {
    --w: 1280px;
    --h: 780px;
    --scale: 0.8;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow), 0 0 0 1px var(--glow), 0 0 120px -30px var(--glow);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 0.85rem;
  }

  .dots {
    display: flex;
    gap: 0.4rem;
  }

  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #f87171;
  }

  .dots i:nth-child(2) {
    background: #fbbf24;
  }

  .dots i:nth-child(3) {
    background: #34d399;
  }

  .url {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--muted);
    font-family: ui-monospace, Menlo, monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .open {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .viewport {
    position: relative;
    height: calc(var(--h) * var(--scale));
    overflow: hidden;
  }

  iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: var(--w);
    height: var(--h);
    border: 0;
    transform: scale(var(--scale));
    transform-origin: 0 0;
    background: var(--surface);
  }

  .fallback {
    display: none;
  }

  .fallback :global(.shot) {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media (max-width: 760px) {
    .viewport {
      display: none;
    }

    .fallback {
      display: block;
    }
  }
</style>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const viewport = demo.querySelector<HTMLElement>(".viewport")!;
    const frame = demo.querySelector<HTMLIFrameElement>("iframe")!;
    const width = 1280;

    new ResizeObserver(([entry]) => {
      if (entry) demo.style.setProperty("--scale", String(Math.min(1, entry.contentRect.width / width)));
    }).observe(viewport);

    // The tutorial reads the same storage key as this page (same origin): store the page theme
    // before the lazy iframe loads, and reload it when the theme changes.
    const storeTheme = () => {
      try {
        localStorage.setItem("ics:theme", document.documentElement.dataset.theme ?? "dark");
      } catch {}
    };
    storeTheme();
    document.addEventListener("themechange", () => {
      storeTheme();
      frame.contentWindow?.location.reload();
    });
  }
</script>
