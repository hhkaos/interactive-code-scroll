---
import Shot from "./Shot.astro";
import { site } from "../../site-config.mjs";

interface Tab {
  /** Tab label. */
  label: string;
  /** Tutorial URL, optionally with a `#step` to open. */
  src: string;
  /** Screenshot name (public/screenshots/<name>-<scheme>.png) shown on narrow screens. */
  fallback: string;
}

interface Props {
  tabs: Tab[];
}

// The tutorial is desktop-first: render it at a desktop size and scale it down to fit.
// Narrow screens get a screenshot that opens the tutorial instead.
// Each tab loads without its #step: native fragment scrolling in a same-origin iframe
// also scrolls this page. The script applies the step after load instead.
const tabs = Astro.props.tabs.map((tab) => {
  const [page = tab.src, step = ""] = tab.src.split("#");
  const url = new URL(tab.src, site);
  return { ...tab, page, step, address: `${url.host}${url.pathname}` };
});
const first = tabs[0]!;
---

<div class="browser" data-demo>
  <div class="chrome">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="tabs" role="tablist" aria-label="Live tutorials">
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`demo-tab-${index}`}
            aria-controls="demo-panel"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-page={tab.page}
            data-step={tab.step}
            data-src={tab.src}
            data-address={tab.address}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
  </div>
  <div class="address">
    <a class="url" href={first.src} target="_blank" rel="noopener">{first.address}</a>
    <a class="open" href={first.src} target="_blank" rel="noopener">Open full screen ↗</a>
  </div>
  <div class="panel" id="demo-panel" role="tabpanel" aria-labelledby="demo-tab-0">
    <div class="viewport">
      <iframe src={first.page} title="Live tutorial demo" loading="lazy"></iframe>
    </div>
    {
      tabs.map((tab, index) => (
        <a class="fallback" href={tab.src} hidden={index !== 0}>
          <Shot name={tab.fallback} alt={`${tab.label}: the embedded tutorial. Tap to open it.`} />
        </a>
      ))
    }
  </div>
</div>

<style>
  .browser {
    --w: 1280px;
    --h: 780px;
    --scale: 0.8;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow), 0 0 0 1px var(--glow), 0 0 120px -30px var(--glow);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    padding: 0.55rem 1rem 0;
    background: var(--surface-2);
    font-size: 0.85rem;
  }

  .dots {
    display: flex;
    gap: 0.4rem;
    align-self: center;
    padding-bottom: 0.55rem;
  }

  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #f87171;
  }

  .dots i:nth-child(2) {
    background: #fbbf24;
  }

  .dots i:nth-child(3) {
    background: #34d399;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  [role="tab"] {
    flex: none;
    padding: 0.5rem 1.1rem;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 0.6rem 0.6rem 0 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  [role="tab"]:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }

  [role="tab"][aria-selected="true"] {
    border-color: var(--border);
    background: var(--surface);
    color: var(--text);
  }

  [role="tab"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .address {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .url {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--muted);
    font-family: ui-monospace, Menlo, monospace;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .url:hover {
    color: var(--text);
  }

  .open {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .viewport {
    position: relative;
    height: calc(var(--h) * var(--scale));
    overflow: hidden;
  }

  iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: var(--w);
    height: var(--h);
    border: 0;
    transform: scale(var(--scale));
    transform-origin: 0 0;
    background: var(--surface);
  }

  .fallback {
    display: none;
  }

  .fallback :global(.shot) {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media (max-width: 760px) {
    .viewport {
      display: none;
    }

    .fallback:not([hidden]) {
      display: block;
    }

    .open,
    .dots {
      display: none;
    }

    .chrome {
      padding: 0.45rem 0.5rem 0;
    }

    [role="tab"] {
      padding: 0.45rem 0.7rem;
      font-size: 0.78rem;
    }

    .address {
      padding: 0.45rem 0.5rem;
    }

    .url {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const viewport = demo.querySelector<HTMLElement>(".viewport")!;
    const frame = demo.querySelector<HTMLIFrameElement>("iframe")!;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = demo.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const fallbacks = [...demo.querySelectorAll<HTMLAnchorElement>(".fallback")];
    const links = demo.querySelectorAll<HTMLAnchorElement>(".url, .open");
    const width = 1280;

    new ResizeObserver(([entry]) => {
      if (entry) demo.style.setProperty("--scale", String(Math.min(1, entry.contentRect.width / width)));
    }).observe(viewport);

    // The tutorial reads the same storage key as this page (same origin): store the page theme
    // before the lazy iframe loads, and reload it when the theme changes.
    const storeTheme = () => {
      try {
        localStorage.setItem("ics:theme", document.documentElement.dataset.theme ?? "dark");
      } catch {}
    };
    storeTheme();

    let current = tabs[0]!;
    let step = current.dataset.step ? `#${current.dataset.step}` : "";

    // Go to the step through the tutorial's hashchange handler, which scrolls only its own panel.
    // A tutorial on another origin (e.g. in local dev) cannot be reached: it opens at its start.
    frame.addEventListener("load", () => {
      if (!step) return;
      try {
        const tutorial = frame.contentWindow!;
        tutorial.history.replaceState(null, "", `${tutorial.location.pathname}${tutorial.location.search}${step}`);
        tutorial.dispatchEvent(new Event("hashchange"));
      } catch {}
    });

    document.addEventListener("themechange", () => {
      storeTheme();
      try {
        step = frame.contentWindow!.location.hash || step;
      } catch {}
      frame.src = current.dataset.page!;
    });

    const select = (tab: HTMLButtonElement) => {
      if (tab === current) return;
      current = tab;
      for (const [index, other] of tabs.entries()) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        fallbacks[index]!.hidden = !selected;
      }
      panel.setAttribute("aria-labelledby", tab.id);
      for (const link of links) link.href = tab.dataset.src!;
      demo.querySelector(".url")!.textContent = tab.dataset.address!;
      step = tab.dataset.step ? `#${tab.dataset.step}` : "";
      frame.src = tab.dataset.page!;
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const next = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: tabs.length - 1 }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        const target = tabs[(next + tabs.length) % tabs.length]!;
        target.focus();
        select(target);
      });
    }
  }
</script>
