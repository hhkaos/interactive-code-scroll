{
  "name": "interactive-code-scroll-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter example-framework-fixture dev",
    "build": "pnpm --filter example-framework-fixture build",
    "check": "pnpm --filter interactive-code-scroll build && pnpm -r check",
    "preflight:docs": "git diff --check",
    "preflight:ui": "pnpm check",
    "preflight:package": "pnpm test && pnpm check && pnpm test:pack",
    "preflight:release": "pnpm test && pnpm check && pnpm test:pack",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
