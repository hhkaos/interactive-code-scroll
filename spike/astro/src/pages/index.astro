---
import { Content } from "../tutorial.mdx";
import Step from "../components/Step.astro";
import VarField from "../components/VarField.astro";
import { files, highlightFile } from "../lib/files.ts";
import "../styles.css";

const highlighted = await Promise.all(files.map(async (f) => ({ path: f.path, html: await highlightFile(f) })));
// Escape "<" so embedded code containing </script> cannot close the data block.
const clientData = JSON.stringify(files.map(({ path, parsed }) => ({ path, parsed }))).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>InteractiveCodeScroll spike — Astro</title>
  </head>
  <body class="calcite-mode-light">
    <div class="layout">
      <main class="docs">
        <Content components={{ Step, VarField }} />
      </main>
      <aside class="right">
        <div class="toolbar">
          <span class="progress"></span>
          <calcite-button appearance="transparent" icon-start="browser" id="toggle-preview">Preview</calcite-button>
          <calcite-button appearance="transparent" icon-start="moon" id="toggle-theme" label="Toggle theme"></calcite-button>
        </div>
        <div class="code-panel">
          <calcite-tab-nav>
            {highlighted.map((h) => <calcite-tab-title data-file={h.path}>{h.path}</calcite-tab-title>)}
          </calcite-tab-nav>
          {highlighted.map((h) => <div class="code" data-file={h.path} hidden set:html={h.html} />)}
        </div>
        <div class="media-panel" hidden></div>
        <div class="preview">
          <div class="preview-toolbar">
            <calcite-button appearance="transparent" icon-start="refresh" id="run">Run</calcite-button>
            <calcite-button appearance="transparent" icon-start="launch" id="open-tab">Open in new tab</calcite-button>
          </div>
          <iframe title="Preview" sandbox="allow-scripts allow-popups allow-forms allow-same-origin"></iframe>
        </div>
      </aside>
    </div>
    <script type="application/json" id="ics-files" set:html={clientData} />
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
