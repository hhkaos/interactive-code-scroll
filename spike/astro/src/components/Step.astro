---
import { assertStepRefs, imageUrls } from "../lib/files.ts";

interface Props {
  id: string;
  file?: string;
  region?: string;
  images?: string[];
}

const { id, file, region, images } = Astro.props;
assertStepRefs({ id, file, region, images });
---

<section class="step" id={id} data-file={file} data-region={region}>
  <slot />
  {
    images?.length ? (
      <template class="step-media">
        <calcite-carousel label="Step images" arrow-type="edge">
          {images.map((name) => (
            <calcite-carousel-item label={name}>
              <img src={imageUrls[name]} alt={name} class="step-image" />
            </calcite-carousel-item>
          ))}
        </calcite-carousel>
      </template>
    ) : null
  }
</section>
