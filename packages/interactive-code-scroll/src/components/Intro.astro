---
import { readTutorialConfig } from "../frontmatter.ts";
import { jsonVarsOf } from "../json-vars.ts";
import { currentTutorial } from "../tutorial-data.ts";
import { parsedFiles, stepFiles } from "../variants.ts";
import StepMedia from "./StepMedia.astro";

// Props are validated at MDX compile time (mdx-validation.ts).
interface Props {
  /** Preview / Result pane state while the intro is shown (on load and when the reader returns to it). */
  preview?: "expanded" | "collapsed" | "keep";
  /** Maximizes the code area or the pane under it while the intro is shown; `none` restores. */
  maximize?: "code" | "preview" | "none";
  /** File tab shown, with no focus, while the intro is shown (relative to each variant folder with variants). */
  file?: string;
  /** Images shown instead of code while the intro is shown (same as on <Step>). */
  images?: string[];
  /** Page shown instead of code while the intro is shown: an `https://` URL or a path under `embeds/`. */
  embed?: string;
  /** The step outline instead of code while the intro is shown (the default without other media; frontmatter `outline: false` turns that off). */
  outline?: boolean;
}

const { preview, maximize, file, images, embed, outline } = Astro.props;
// No file or media of its own: the browser shows the outline unless `outline: false` (client/steps.ts).
const autoOutline = !outline && file === undefined && !images?.length && embed === undefined;
const { files, frontmatter } = currentTutorial(Astro.locals);
const { variants } = readTutorialConfig(frontmatter);
const variantFiles = variants && file !== undefined ? stepFiles(variants, parsedFiles(files, jsonVarsOf(frontmatter)), { file }) : undefined;
---

<section
  class="intro"
  data-preview={preview}
  data-maximize={maximize}
  data-file={variants ? undefined : file}
  data-files={variantFiles ? JSON.stringify(variantFiles) : undefined}
  data-auto-outline={autoOutline ? "" : undefined}
>
  <slot />
  <StepMedia images={images} embed={embed} outline={outline} />
</section>
