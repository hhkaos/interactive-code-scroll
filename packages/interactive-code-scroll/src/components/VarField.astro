---
import { formValue, parseSource, varKind } from "../markers.ts";
import { currentTutorial } from "../tutorial-data.ts";
import { parsedFiles } from "../variants.ts";
import { jsonVarsOf } from "../json-vars.ts";

interface Props {
  name: string;
  label: string;
  /** `config.json#/a/b`: a value of a JSON file (no comments for `@var` there); a list for several files. */
  json?: string | string[];
  placeholder?: string;
  secret?: boolean;
  /** `persist` shares the value with every tutorial of the site; `persist="tutorial"` keeps it to this one. */
  persist?: boolean | "tutorial";
}

const { name, label, placeholder, secret = false, persist = false } = Astro.props;
const { files, frontmatter, requests } = currentTutorial(Astro.locals);
// Validation guarantees every file that marks the var (code/ or requests/) has the same type and default.
const ref = [
  ...parsedFiles(files, jsonVarsOf(frontmatter)).values(),
  ...requests.map((f) => parseSource(f.source, `requests/${f.path}`)),
]
  .flatMap((parsed) => parsed.vars)
  .find((v) => v.name === name);
const kind = ref ? varKind(ref) : "string";
const defaultValue = ref && formValue(ref);
const persistScope = persist === "tutorial" ? "tutorial" : persist ? "site" : undefined;
---

{
  kind === "boolean" ? (
    <calcite-label class="var-field" layout="inline">
      <calcite-switch
        data-var={name}
        data-kind={kind}
        data-default-value={defaultValue}
        data-persist={persistScope}
        // Astro writes `checked="false"` on custom elements, and any `checked` attribute means on.
        checked={defaultValue === "true" || undefined}
      />
      {label}
    </calcite-label>
  ) : (
    <calcite-input
      class="var-field"
      label-text={label}
      data-var={name}
      data-kind={kind}
      data-default-value={defaultValue}
      data-persist={persistScope}
      data-secret={secret ? "" : undefined}
      placeholder={placeholder ?? defaultValue}
      type={secret ? "password" : kind === "number" ? "number" : "text"}
    >
      {/* Calcite's `action` slot joins the reveal toggle to the input. */}
      {secret && <calcite-action slot="action" icon="view-visible" text="Show value" data-reveal={name} />}
    </calcite-input>
  )
}
