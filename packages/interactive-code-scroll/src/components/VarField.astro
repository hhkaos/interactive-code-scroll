---
import { files } from "virtual:interactive-code-scroll/tutorial";
import { parseSource } from "../markers.ts";

interface Props {
  name: string;
  label: string;
  secret?: boolean;
  persist?: boolean;
}

const { name, label, secret = false, persist = false } = Astro.props;
const defaultValue = files
  .flatMap((f) => parseSource(f.source).vars)
  .find((v) => v.name === name)?.defaultValue;
---

<calcite-input
  class="var-field"
  label-text={label}
  data-var={name}
  data-persist={persist ? "" : undefined}
  data-secret={secret ? "" : undefined}
  placeholder={defaultValue}
  type={secret ? "password" : "text"}
>
  {/* Calcite's `action` slot joins the reveal toggle to the input. */}
  {secret && <calcite-action slot="action" icon="view-visible" text="Show value" data-reveal={name} />}
</calcite-input>
