---
import { resolveOptions, type FieldOption, type FieldType } from "../field-options.ts";
import { formValue, parseSource, varKind } from "../markers.ts";
import { currentTutorial } from "../tutorial-data.ts";
import { parsedFiles } from "../variants.ts";
import { jsonVarsOf } from "../json-vars.ts";

interface Props {
  name: string;
  label: string;
  /** Text field by default; a number var gets a number field and a boolean var a switch. */
  type?: FieldType;
  /** Choices of `select`, `radio` and `combobox`: an array, or a JSON file in `field-options/`. */
  options?: (string | number | { value: string | number; label?: string })[] | string;
  /** `config.json#/a/b`: a value of a JSON file (no comments for `@var` there); a list for several files. */
  json?: string | string[];
  placeholder?: string;
  secret?: boolean;
  /** `persist` shares the value with every tutorial of the site; `persist="tutorial"` keeps it to this one. */
  persist?: boolean | "tutorial";
  /** Radio buttons stack by default; `horizontal` puts them in a row. */
  layout?: "vertical" | "horizontal";
}

const { name, label, type = "text", options: rawOptions, placeholder, secret = false, persist = false, layout = "vertical" } = Astro.props;
const { files, fieldOptions, frontmatter, requests } = currentTutorial(Astro.locals);
// Validation guarantees every file that marks the var (code/ or requests/) has the same type and default.
const ref = [
  ...parsedFiles(files, jsonVarsOf(frontmatter)).values(),
  ...requests.map((f) => parseSource(f.source, `requests/${f.path}`)),
]
  .flatMap((parsed) => parsed.vars)
  .find((v) => v.name === name);
const kind = ref ? varKind(ref) : "string";
const defaultValue = ref && formValue(ref);
// Validated at MDX compile time; an invalid list renders no choices.
const resolved = rawOptions === undefined ? [] : resolveOptions(rawOptions, fieldOptions);
const options: FieldOption[] = typeof resolved === "string" ? [] : resolved;
const data = {
  "data-var": name,
  "data-kind": kind,
  "data-field": type,
  "data-default-value": defaultValue,
  "data-persist": persist === "tutorial" ? "tutorial" : persist ? "site" : undefined,
};
// Astro writes `checked="false"` (or `selected="false"`) on custom elements, and any such attribute means on.
const on = (value: boolean) => value || undefined;
---

{
  kind === "boolean" ? (
    <calcite-label class="var-field" layout="inline">
      <calcite-switch {...data} checked={on(defaultValue === "true")} />
      {label}
    </calcite-label>
  ) : type === "textarea" ? (
    <calcite-text-area class="var-field" label-text={label} placeholder={placeholder ?? defaultValue} resize="vertical" {...data} />
  ) : type === "select" ? (
    <calcite-select class="var-field" label-text={label} {...data}>
      {options.map((o) => (
        <calcite-option value={o.value} selected={on(o.value === defaultValue)}>
          {o.label}
        </calcite-option>
      ))}
    </calcite-select>
  ) : type === "radio" ? (
    <calcite-radio-button-group class="var-field" label-text={label} name={`var-${name}`} layout={layout} {...data}>
      {options.map((o) => (
        <calcite-label layout="inline">
          <calcite-radio-button value={o.value} checked={on(o.value === defaultValue)} />
          {o.label}
        </calcite-label>
      ))}
    </calcite-radio-button-group>
  ) : type === "combobox" ? (
    <calcite-combobox
      class="var-field"
      label-text={label}
      selection-mode="single"
      placeholder={placeholder ?? "Search"}
      clear-disabled={on(defaultValue !== "")}
      {...data}
    >
      {options.map((o) => (
        <calcite-combobox-item value={o.value} heading={o.label} selected={on(o.value === defaultValue)} />
      ))}
    </calcite-combobox>
  ) : (
    <calcite-input
      class="var-field"
      label-text={label}
      {...data}
      data-secret={secret ? "" : undefined}
      placeholder={placeholder ?? defaultValue}
      type={secret ? "password" : kind === "number" ? "number" : "text"}
    >
      {/* Calcite's `action` slot joins the reveal toggle to the input. */}
      {secret && <calcite-action slot="action" icon="view-visible" text="Show value" data-reveal={name} />}
    </calcite-input>
  )
}
