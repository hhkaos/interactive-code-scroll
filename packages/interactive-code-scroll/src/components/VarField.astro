---
import { parseSource } from "../markers.ts";
import { currentTutorial } from "../tutorial-data.ts";

interface Props {
  name: string;
  label: string;
  placeholder?: string;
  secret?: boolean;
  /** `persist` shares the value with every tutorial of the site; `persist="tutorial"` keeps it to this one. */
  persist?: boolean | "tutorial";
}

const { name, label, placeholder, secret = false, persist = false } = Astro.props;
const { files, requests } = currentTutorial(Astro.locals);
// Validation guarantees every file that marks the var (code/ or requests/) has the same default.
const defaultValue = [
  ...files.map((f) => parseSource(f.source, `code/${f.path}`)),
  ...requests.map((f) => parseSource(f.source, `requests/${f.path}`)),
]
  .flatMap((parsed) => parsed.vars)
  .find((v) => v.name === name)?.defaultValue;
---

<calcite-input
  class="var-field"
  label-text={label}
  data-var={name}
  data-default-value={defaultValue}
  data-persist={persist === "tutorial" ? "tutorial" : persist ? "site" : undefined}
  data-secret={secret ? "" : undefined}
  placeholder={placeholder ?? defaultValue}
  type={secret ? "password" : "text"}
>
  {/* Calcite's `action` slot joins the reveal toggle to the input. */}
  {secret && <calcite-action slot="action" icon="view-visible" text="Show value" data-reveal={name} />}
</calcite-input>
