---
import { base, seriesImages, seriesIndex, tutorials } from "virtual:interactive-code-scroll/tutorial";
import { readIndexConfig } from "../frontmatter.ts";
import { cardParts, parseTagList, selectCards, tagFor } from "../series.ts";
import { seriesCards } from "../tutorial-data.ts";
import "@esri/calcite-components/main.css";
import "../styles/series-list.css";

// Attributes are validated at MDX compile time in index.mdx (a custom index page gets its types);
// tag and level values are checked here, where the tutorials' metadata is known.
interface Props {
  /** Comma-separated tags: the list shows tutorials with any of them. */
  tags?: string;
  /** Exact level: the list shows tutorials with that level. */
  level?: string;
}

const { tags, level } = Astro.props;
const groups = readIndexConfig(seriesIndex?.frontmatter ?? {}).tagGroups ?? [];
const cards = seriesCards(tutorials, base, groups, seriesImages);
const wanted = parseTagList(tags);
const unknownTags = wanted.filter((tag) => !cards.some((card) => card.tags.includes(tag)));
if (unknownTags.length > 0) {
  throw new Error(`<TutorialList tags="${tags}">: no tutorial has the tag(s) ${unknownTags.map((t) => `"${t}"`).join(", ")}`);
}
if (level !== undefined && !cards.some((card) => card.level === level)) {
  throw new Error(`<TutorialList level="${level}">: no tutorial has that level`);
}
// Family colors of index.mdx tagGroups (a custom page's <TutorialFilter tagGroups> sets them from the client).
const familyIndex = new Map(groups.flatMap((group, index) => group.tags.map((tag) => [tag, index] as const)));
const shown = selectCards(cards, { tags: wanted, ...(level === undefined ? {} : { level }) });
// Variant links past the fourth collapse into "+N"; linked variant labels leave the plain tag line.
const rows = shown.map((card) => ({ card, ...cardParts(card) }));
---

<div class="series-list">
  <ul class="series-cards">
    {
      rows.map(({ card, links, more, plainTags }) => (
        <li class="series-card-item" data-slug={card.slug} data-tags={JSON.stringify(card.tags)} data-level={card.level}>
          {/* The title link covers the card (stretched link); variant links sit above it, so links never nest. */}
          <article class="series-card">
            <h3 class="series-card-heading">
              {/* One line: the search highlights the title's text as is. */}
              <a class="series-card-title" href={card.href} data-href={card.href}>{card.title}</a>
            </h3>
            {card.description && <p class="series-card-description">{card.description}</p>}
            {(card.level || card.duration) && (
              <p class="series-card-meta">
                {card.level && (
                  <span>
                    <calcite-icon icon="gauge" scale="s" aria-hidden="true" />
                    <span class="visually-hidden">Level:</span> {card.level}
                  </span>
                )}
                {card.duration && (
                  <span>
                    <calcite-icon icon="clock" scale="s" aria-hidden="true" />
                    <span class="visually-hidden">Duration:</span> {card.duration}
                  </span>
                )}
              </p>
            )}
            {plainTags.length > 0 && (
              <ul class="series-card-tags" aria-label="Tags">
                {/* A tag with a logo shows it instead of the family dot; the name always shows (some logos are shared). */}
                {plainTags.map((tag) => (
                  <li data-tag={tag} data-family={familyIndex.get(tag)} class:list={{ "has-logo": card.tagLogos?.[tag] }}>
                    {card.tagLogos?.[tag] && <img src={card.tagLogos[tag]} alt="" />}
                    {tag}
                  </li>
                ))}
              </ul>
            )}
            {links.length > 0 && (
              <div class="series-card-variants">
                <p class="series-card-variants-label" aria-hidden="true">
                  Available in
                </p>
                <ul aria-label="Available in">
                  {links.map((link, i) => (
                    <li>
                      <a class="series-card-variant" href={link.href} data-tag={tagFor(link.label, card.tags) ?? link.label}>
                        {link.logo && <img src={link.logo} alt="" />}
                        {link.label}
                        <span class="visually-hidden">: {card.title}</span>
                      </a>
                      {i === links.length - 1 && more.length > 0 && (
                        <a class="series-card-variant-more" href={card.href} title={more.map((v) => v.label).join(", ")}>
                          +{more.length}
                          <span class="visually-hidden"> more: {more.map((v) => v.label).join(", ")}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        </li>
      ))
    }
  </ul>
  <p class="series-empty" hidden>No tutorials match the filters.</p>
</div>

<script>
  import "@esri/calcite-components/components/calcite-icon";
</script>
