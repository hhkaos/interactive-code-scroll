---
import { base, seriesIndex, tutorials } from "virtual:interactive-code-scroll/tutorial";
import { readIndexConfig } from "../frontmatter.ts";
import { parseTagList, selectCards } from "../series.ts";
import { seriesCards } from "../tutorial-data.ts";
import "@esri/calcite-components/main.css";
import "../styles/series-list.css";

// Attributes are validated at MDX compile time in index.mdx (a custom index page gets its types);
// tag and level values are checked here, where the tutorials' metadata is known.
interface Props {
  /** Comma-separated tags: the list shows tutorials with any of them. */
  tags?: string;
  /** Exact level: the list shows tutorials with that level. */
  level?: string;
}

const { tags, level } = Astro.props;
const cards = seriesCards(tutorials, base);
const wanted = parseTagList(tags);
const unknownTags = wanted.filter((tag) => !cards.some((card) => card.tags.includes(tag)));
if (unknownTags.length > 0) {
  throw new Error(`<TutorialList tags="${tags}">: no tutorial has the tag(s) ${unknownTags.map((t) => `"${t}"`).join(", ")}`);
}
if (level !== undefined && !cards.some((card) => card.level === level)) {
  throw new Error(`<TutorialList level="${level}">: no tutorial has that level`);
}
// Family colors of index.mdx tagGroups (a custom page's <TutorialFilter tagGroups> sets them from the client).
const familyIndex = new Map(
  (readIndexConfig(seriesIndex?.frontmatter ?? {}).tagGroups ?? []).flatMap((group, index) => group.tags.map((tag) => [tag, index] as const)),
);
const shown = selectCards(cards, { tags: wanted, ...(level === undefined ? {} : { level }) });
---

<div class="series-list">
  <ul class="series-cards">
    {
      shown.map((card) => (
        <li class="series-card-item" data-slug={card.slug} data-tags={JSON.stringify(card.tags)} data-level={card.level}>
          <a class="series-card" href={card.href}>
            <div class="series-card-head">
              {/* Next to the title, the tutorial logo is decorative; variant logos stand alone, so they keep their label. */}
              {card.logo && <img class="series-card-logo" src={card.logo} alt="" />}
              {card.variantLogos && (
                <span class="series-card-variant-logos">
                  {card.variantLogos.map((v) => (
                    <img class="series-card-variant-logo" src={v.src} alt={v.label} title={v.label} />
                  ))}
                </span>
              )}
              <h3 class="series-card-title">{card.title}</h3>
            </div>
            {card.description && <p class="series-card-description">{card.description}</p>}
            {(card.level || card.duration) && (
              <p class="series-card-meta">
                {card.level && (
                  <span>
                    <calcite-icon icon="gauge" scale="s" aria-hidden="true" />
                    <span class="visually-hidden">Level:</span> {card.level}
                  </span>
                )}
                {card.duration && (
                  <span>
                    <calcite-icon icon="clock" scale="s" aria-hidden="true" />
                    <span class="visually-hidden">Duration:</span> {card.duration}
                  </span>
                )}
              </p>
            )}
            {card.tags.length > 0 && (
              <ul class="series-card-tags" aria-label="Tags">
                {card.tags.map((tag) => (
                  <li data-family={familyIndex.get(tag)}>{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="series-empty" hidden>No tutorials match the filters.</p>
</div>

<script>
  import "@esri/calcite-components/components/calcite-icon";
</script>
