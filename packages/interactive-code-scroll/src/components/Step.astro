---
import { files, frontmatter, images as imageUrls } from "virtual:interactive-code-scroll/tutorial";
import { readTutorialConfig } from "../frontmatter.ts";
import { parsedFiles, stepFiles } from "../variants.ts";

// References are validated at MDX compile time (mdx-validation.ts).
interface Props {
  id: string;
  file?: string;
  region?: string;
  images?: string[];
  preview?: "expanded" | "collapsed" | "keep";
  /** Space-separated variant ids the step applies to. */
  only?: string;
}

const { id, file, region, images, preview, only } = Astro.props;
const { variants } = readTutorialConfig(frontmatter);
// With variants, `file` is relative to each variant folder and a lone `region` names a file per variant.
const variantFiles = variants && stepFiles(variants, parsedFiles(files), { file, region, only });
---

<section
  class="step"
  id={id}
  data-file={variants ? undefined : file}
  data-files={variantFiles && Object.keys(variantFiles).length > 0 ? JSON.stringify(variantFiles) : undefined}
  data-only={variants ? only : undefined}
  data-region={region}
  data-preview={preview}
>
  <slot />
  {
    images?.length ? (
      <template class="step-media">
        <calcite-carousel label="Step images" arrow-type="edge">
          {images.map((name) => (
            <calcite-carousel-item label={name}>
              <img src={imageUrls[name]} alt={name} class="step-image" />
            </calcite-carousel-item>
          ))}
        </calcite-carousel>
      </template>
    ) : null
  }
</section>
