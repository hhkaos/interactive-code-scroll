---
import { readTutorialConfig } from "../frontmatter.ts";
import { isJsonRegion, jsonRegionId, jsonVarsOf } from "../json-vars.ts";
import { PREVIEW_ENTRY } from "../preview/build-html.ts";
import { currentTutorial } from "../tutorial-data.ts";
import { parsedFiles, resultVariants, stepFiles, stepOutputs } from "../variants.ts";
import StepMedia from "./StepMedia.astro";

// References are validated at MDX compile time (mdx-validation.ts).
interface Props {
  id: string;
  file?: string;
  /** A `#region` id, or a JSON Pointer (`/dependencies`) into a `.json` `file`. */
  region?: string;
  images?: string[];
  /** Page shown instead of code: an `https://` URL or a path under `embeds/` (e.g. `slides/#/3`). */
  embed?: string;
  preview?: "expanded" | "collapsed" | "keep";
  /** Maximizes the code area or the pane under it (Preview or Result) when the step becomes active; `none` restores. */
  maximize?: "code" | "preview" | "none";
  /** Space-separated variant ids the step applies to. */
  only?: string;
  /** Captured output under `output/` shown in the Result pane (per-variant override in `output/<variant>/`). */
  output?: string;
  /** Space-separated `# @name`s of requests/ the Result pane can run; the first is the default. */
  request?: string;
}

const { id, file, region, images, embed, preview, maximize, only, output, request } = Astro.props;
const { files, frontmatter, outputs } = currentTutorial(Astro.locals);
const { variants } = readTutorialConfig(frontmatter);
// With variants, `file` is relative to each variant folder and a lone `region` names a file per variant.
const variantFiles = variants && stepFiles(variants, parsedFiles(files, jsonVarsOf(frontmatter)), { file, region, only });
// Web code shows the Preview: validation rejects `output` there without variants, and web variants get none.
const webDirs = new Set(variants?.filter((v) => files.some((f) => f.path === `${v.dir}/${PREVIEW_ENTRY}`)).map((v) => v.dir));
const variantOutputs = variants && output !== undefined ? stepOutputs(variants, outputs, webDirs, { output, only }) : undefined;
const requests = request?.split(/\s+/).filter(Boolean);
const requestVariants = variants && requests && resultVariants(variants, webDirs, only).map((v) => v.id);
---

<section
  class="step"
  id={id}
  data-file={variants ? undefined : file}
  data-files={variantFiles && Object.keys(variantFiles).length > 0 ? JSON.stringify(variantFiles) : undefined}
  data-only={variants ? only : undefined}
  data-region={region !== undefined && isJsonRegion(region) ? jsonRegionId(region) : region}
  data-preview={preview}
  data-maximize={maximize}
  data-output={variants ? undefined : output}
  data-outputs={variantOutputs && Object.keys(variantOutputs).length > 0 ? JSON.stringify(variantOutputs) : undefined}
  data-requests={requests?.join(" ")}
  data-request-variants={requestVariants ? JSON.stringify(requestVariants) : undefined}
>
  <slot />
  <StepMedia images={images} embed={embed} />
</section>
