---
import { images as imageUrls } from "virtual:interactive-code-scroll/tutorial";

// References are validated at MDX compile time (mdx-validation.ts).
interface Props {
  id: string;
  file?: string;
  region?: string;
  images?: string[];
  preview?: "expanded" | "collapsed" | "keep";
}

const { id, file, region, images, preview } = Astro.props;
---

<section class="step" id={id} data-file={file} data-region={region} data-preview={preview}>
  <slot />
  {
    images?.length ? (
      <template class="step-media">
        <calcite-carousel label="Step images" arrow-type="edge">
          {images.map((name) => (
            <calcite-carousel-item label={name}>
              <img src={imageUrls[name]} alt={name} class="step-image" />
            </calcite-carousel-item>
          ))}
        </calcite-carousel>
      </template>
    ) : null
  }
</section>
