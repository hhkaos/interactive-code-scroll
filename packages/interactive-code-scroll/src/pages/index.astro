---
import { binaries, Content, files, frontmatter, images, outputs, requests } from "virtual:interactive-code-scroll/tutorial";
import Hint from "../components/Hint.astro";
import Intro from "../components/Intro.astro";
import Step from "../components/Step.astro";
import VarField from "../components/VarField.astro";
import { readTutorialConfig } from "../frontmatter.ts";
import { highlight } from "../highlight.ts";
import { parseSource } from "../markers.ts";
import { zipBadge, zipLabel } from "../downloads.ts";
import { PREVIEW_ENTRY } from "../preview/build-html.ts";
import { MAX_SEGMENTED } from "../client/variant-values.ts";
import { variantVisible } from "../variants.ts";
import { selectVisible } from "../visible-files.ts";
import { ERROR_RULE_FILE, readErrorRule } from "../error-rule.ts";
import { parseHttpFile, runnerRequests } from "../requests.ts";
import "../styles/tutorial.css";

// Frontmatter and references are validated at MDX compile time (mdx-validation.ts).
const config = readTutorialConfig(frontmatter);
const logo = config.logo === undefined ? undefined : images[config.logo];
const textPaths = files.map((f) => f.path);
const { variants } = config;
// Each variant's tabs, in order; a tutorial without variants is one unnamed group.
const groups = variants
  ? variants.map((v) => ({ variant: v, prefix: `${v.dir}/`, entry: `${v.dir}/${v.entry}`, paths: variantVisible(v, textPaths).visible }))
  : [{ variant: undefined, prefix: "", entry: undefined, paths: selectVisible(textPaths, config.files).visible }];
const visible = groups.flatMap((g) => g.paths);
// A variant is web code when its folder has index.html: only those get the Preview.
const previewEntries = variants ? variants.map((v) => `${v.dir}/${PREVIEW_ENTRY}`).filter((path) => textPaths.includes(path)) : [PREVIEW_ENTRY];
const preview = previewEntries.length > 0 ? config.preview : "off";
const firstIsWeb = !variants || previewEntries.includes(`${variants[0]!.dir}/${PREVIEW_ENTRY}`);
// Code that is not web (a variant without index.html, or a tutorial without it) shows captured
// outputs and runs requests in the Result pane instead; the client hides it unless some step has
// an `output` or a `request`.
const hasResult =
  (outputs.length > 0 || requests.length > 0) && (variants ? previewEntries.length < variants.length : !textPaths.includes(PREVIEW_ENTRY));
const resultFirst = variants ? !firstIsWeb : true;
// The page embeds tabbed files plus the Preview entries; the ZIP fetches everything else from preview/.
const embedded = new Set([...visible, ...previewEntries]);
const parsed = files.filter((f) => embedded.has(f.path)).map((f) => ({ path: f.path, parsed: parseSource(f.source, `code/${f.path}`) }));
const highlighted = new Map(
  await Promise.all(
    visible.map(async (path) => [path, await highlight(parsed.find((f) => f.path === path)!.parsed, path, config.languages)] as const),
  ),
);
// First shown: the first variant's entry, else the first tab.
const initialFile = groups[0]!.entry ?? visible[0];
const selectedIn = (group: (typeof groups)[number]) => group.entry ?? group.paths[0];
const fetched = [...files.map((f) => f.path).filter((path) => !embedded.has(path)), ...binaries].sort();
// requests/ goes into every ZIP next to the project, with form values applied to its file variables.
const requestFiles = requests.map((f) => ({ path: f.path, parsed: parseSource(f.source, `requests/${f.path}`) }));
// The Result pane's runner gets the named requests already parsed (validation reported any error).
const runner = runnerRequests(requests.filter((f) => f.path.endsWith(".http")).map((f) => parseHttpFile(f.source, f.path).file));
// Service errors in response bodies: requests/errors.json (validation reported any error).
const errorRuleSource = requests.find((f) => f.path === ERROR_RULE_FILE)?.source;
const errorRule = errorRuleSource === undefined ? undefined : readErrorRule(errorRuleSource).rule;
// Files in each ZIP (a variant's ZIP holds its own folder) and how many of them have no tab.
const allPaths = [...textPaths, ...binaries];
const zipCountsFor = (inZip: (path: string) => boolean) => {
  const paths = allPaths.filter(inZip);
  const withoutTab = paths.filter((path) => !visible.includes(path)).length + requests.length;
  return { total: paths.length + requests.length, withoutTab };
};
const zipCounts = variants && Object.fromEntries(variants.map((v) => [v.id, zipCountsFor((path) => path.startsWith(`${v.dir}/`))]));
const initialZip = zipCounts ? zipCounts[variants![0]!.id]! : zipCountsFor(() => true);
const withIframe = preview === "iframe" || preview === "both";
const withTab = preview === "tab" || preview === "both";
const clientVariants = variants?.map(({ id, label, dir, entry }) => ({ id, label, dir, entry }));
// Escape "<" so embedded code containing </script> cannot close the data block.
const clientData = JSON.stringify({
  title: config.title,
  preview,
  files: parsed,
  fetched,
  requests: requestFiles,
  runner,
  errorRule,
  zipCounts,
  variants: clientVariants,
  otherVariantSteps: config.otherVariantSteps,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.title}</title>
    {logo && <link rel="icon" href={logo} />}
  </head>
  <body data-preview={preview} data-theme={config.theme} data-code-wrap={config.codeWrap ? "" : undefined}>
    <script is:inline>
      // Before first paint: avoid a flash of the wrong theme. Mirrors client/layout-values.ts.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("ics:theme");
        } catch (e) {}
        var choice = stored === "light" || stored === "dark" ? stored : document.body.dataset.theme;
        var dark = choice === "dark" || (choice !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.body.className = dark ? "calcite-mode-dark" : "calcite-mode-light";
      })();
    </script>
    <calcite-navigation class="app-header">
      {/* The page's h1: tutorial.mdx should not repeat the title. */}
      <calcite-navigation-logo slot="logo" heading={config.title} heading-level="1" thumbnail={logo} />
      <div slot="content-end" class="header-actions">
        <span id="step-count" aria-live="polite"></span>
        <calcite-action id="present-toggle" icon="presentation" text="Present" />
        <calcite-action id="theme-toggle" icon="moon" text="Toggle theme" />
      </div>
      <calcite-progress slot="progress" id="progress-bar" value="0" label="Tutorial progress" />
    </calcite-navigation>
    <div class="layout">
      <main class="docs">
        <Content components={{ Hint, Intro, Step, VarField }} />
      </main>
      <div class="gutter">
        <div
          class="splitter"
          role="separator"
          tabindex="0"
          aria-orientation="vertical"
          aria-label="Resize explanations"
          aria-valuemin="20"
          aria-valuemax="70"
          data-own-keys
        >
        </div>
        {/* On the edge it controls; stays visible (as a rail) while the explanations are hidden. */}
        <calcite-action id="docs-toggle" class="docs-toggle" icon="chevrons-left" text="Hide explanations" scale="s" />
      </div>
      <aside class="right">
        <div class="code-panel">
          <div class="panel-header">
            {
              variants && (
                <>
                  {/* Segmented up to MAX_SEGMENTED variants; client/variants.ts falls back to the dropdown when it does not fit. */}
                  {variants.length <= MAX_SEGMENTED && (
                    <calcite-segmented-control id="variant-switcher" label="Code language" scale="s">
                      {variants.map((v, i) => (
                        <calcite-segmented-control-item value={v.id} checked={i === 0 || undefined}>
                          {v.label}
                        </calcite-segmented-control-item>
                      ))}
                    </calcite-segmented-control>
                  )}
                  <calcite-dropdown id="variant-dropdown" scale="s" hidden={variants.length <= MAX_SEGMENTED || undefined}>
                    <calcite-button slot="trigger" kind="neutral" appearance="outline" scale="s" icon-end="chevron-down" label="Code language">
                      {variants[0]!.label}
                    </calcite-button>
                    <calcite-dropdown-group selection-mode="single" group-title="Code language">
                      {variants.map((v, i) => (
                        <calcite-dropdown-item data-variant={v.id} selected={i === 0 || undefined}>
                          {v.label}
                        </calcite-dropdown-item>
                      ))}
                    </calcite-dropdown-group>
                  </calcite-dropdown>
                  <span class="header-divider" aria-hidden="true" />
                </>
              )
            }
            {
              groups.map((group, g) => (
                <calcite-tab-nav data-variant={group.variant?.id} hidden={g !== 0 || undefined}>
                  {group.paths.map((path) => (
                    <calcite-tab-title data-file={path} selected={path === selectedIn(group)} icon-start="file-code">
                      {path.slice(group.prefix.length)}
                    </calcite-tab-title>
                  ))}
                </calcite-tab-nav>
              ))
            }
            <calcite-action id="copy-file" icon="copy-to-clipboard" text="Copy file" />
            <calcite-action id="download-file" icon="download" text="Download file" />
            {/* Our own count badge: Calcite has no numeric badge, and its `indicator` dot fails to render without t9n files (offline). */}
            <span class="zip-action" data-count={zipBadge(initialZip.total)}>
              <calcite-action id="download-zip" icon="file-zip" text={zipLabel(initialZip.total, initialZip.withoutTab)} />
            </span>
          </div>
          {
            variants && (
              <calcite-notice id="variant-notice" kind="info" icon="information" scale="s" width="full">
                <div slot="message" />
                <calcite-link slot="link" />
              </calcite-notice>
            )
          }
          {visible.map((path) => <div class="code" data-file={path} hidden={path !== initialFile} set:html={highlighted.get(path)} />)}
        </div>
        <div class="media-panel" hidden></div>
        {
          preview !== "off" && (
            <section class="preview" aria-label="Preview" hidden={!firstIsWeb || undefined}>
              {withIframe && (
                <div
                  class="preview-splitter"
                  role="separator"
                  tabindex="0"
                  aria-orientation="horizontal"
                  aria-label="Resize preview"
                  aria-valuemin="15"
                  aria-valuemax="85"
                  data-own-keys
                />
              )}
              <div class="panel-header">
                {withIframe ? (
                  <calcite-action id="preview-toggle" icon="chevron-down" text="Preview" text-enabled />
                ) : (
                  <span class="panel-title">Preview</span>
                )}
                {withIframe && <calcite-action id="preview-run" icon="refresh" text="Run" text-enabled />}
                {withTab && <calcite-action id="preview-open" icon="launch" text="Open in new tab" text-enabled />}
              </div>
              {withIframe && (
                <div class="preview-frame">
                  {/* Same origin is required: the SDK's OAuth callback talks to window.opener. */}
                  <iframe title="Preview" sandbox="allow-scripts allow-popups allow-forms allow-same-origin allow-modals" />
                </div>
              )}
            </section>
          )
        }
        {
          hasResult && (
            <section class="result" aria-label="Result" hidden={!resultFirst || undefined}>
              {/* Shares its size (and remembered height) with the Preview: layout.ts drives both splitters together. */}
              <div
                class="preview-splitter"
                role="separator"
                tabindex="0"
                aria-orientation="horizontal"
                aria-label="Resize result"
                aria-valuemin="15"
                aria-valuemax="85"
                data-own-keys
              />
              <div class="panel-header">
                <calcite-action id="result-toggle" icon="chevron-down" text="Result" text-enabled />
                <span class="result-badge" hidden />
                <span class="result-run-as" hidden>
                  <span id="result-run-as-label">Run as</span>
                  <calcite-segmented-control id="result-run-as" label="Run as" scale="s" />
                </span>
                <calcite-action id="result-keep" icon="pin" text="Keep response" text-enabled hidden />
                <calcite-action id="result-captured" icon="reset" text="Show captured" text-enabled hidden />
                <calcite-button id="result-run" icon-start="play" scale="s" hidden>Run request</calcite-button>
              </div>
              <div class="result-frame">
                <div class="result-live">
                  <div class="result-request" hidden>
                    <code class="result-request-line" />
                    <span class="result-request-source" />
                    <calcite-action id="result-reveal" icon="view-visible" text="Show secrets" scale="s" />
                  </div>
                  <calcite-notice id="result-notice" kind="warning" icon="exclamation-mark-triangle" scale="s" width="full">
                    <div slot="message" />
                  </calcite-notice>
                  <calcite-notice id="result-error" kind="danger" icon="exclamation-mark-circle" scale="s" width="full">
                    <div slot="message" />
                  </calcite-notice>
                  <calcite-tab-nav id="result-tabs" hidden>
                    <calcite-tab-title data-tab="body" selected>Body</calcite-tab-title>
                    <calcite-tab-title data-tab="headers">Headers</calcite-tab-title>
                  </calcite-tab-nav>
                  <div class="result-body" tabindex="0" role="region" aria-label="Result output">
                    <p class="result-empty">No result yet. Steps with a captured output show it here, and steps with a request can run it.</p>
                  </div>
                </div>
              </div>
            </section>
          )
        }
      </aside>
    </div>
    <calcite-dialog id="image-viewer" modal placement="cover" heading="Image">
      <img alt="" />
    </calcite-dialog>
    <script type="application/json" id="ics-data" set:html={clientData} />
    <script>
      import "../client/calcite.ts";
      import type { ParsedSource } from "../markers.ts";
      import type { ErrorRule } from "../error-rule.ts";
      import type { RunnerRequest } from "../requests.ts";
      import { startDocsCodeBlocks } from "../client/docs-code.ts";
      import { startHints } from "../client/hints.ts";
      import { keyToDelta } from "../client/navigation.ts";
      import { startTooltips } from "../client/actions.ts";
      import { startDownloads } from "../client/downloads.ts";
      import { startImageViewer } from "../client/image-viewer.ts";
      import { startLayout } from "../client/layout.ts";
      import { startPresentation } from "../client/presentation.ts";
      import { startPreview } from "../client/preview.ts";
      import { startResult } from "../client/result.ts";
      import { startStepEngine } from "../client/steps.ts";
      import { startVars } from "../client/vars.ts";
      import { startVariants, type VariantInfo } from "../client/variants.ts";

      const data = JSON.parse(document.querySelector("#ics-data")!.textContent!) as {
        title: string;
        preview: "off" | "iframe" | "tab" | "both";
        files: { path: string; parsed: ParsedSource }[];
        fetched: string[];
        requests: { path: string; parsed: ParsedSource }[];
        runner: Record<string, RunnerRequest>;
        errorRule?: ErrorRule;
        zipCounts?: Record<string, { total: number; withoutTab: number }>;
        variants?: VariantInfo[];
        otherVariantSteps: "notice" | "hide";
      };

      startTooltips();
      startDocsCodeBlocks();
      startHints();
      startLayout();
      startPresentation();
      const variants = data.variants && startVariants(data.variants);
      const engine = startStepEngine({ variants, otherVariantSteps: data.otherVariantSteps });
      startImageViewer();
      let refreshPreview = () => {};
      let refreshRequest = () => {};
      const vars = startVars(() => {
        refreshPreview();
        refreshRequest();
      });
      const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
      const pageUrl = `${base}preview/`;
      startDownloads({
        files: data.files,
        fetched: data.fetched,
        requests: data.requests,
        previewUrl: pageUrl,
        values: vars.values,
        title: data.title,
        variants,
        zipCounts: data.zipCounts,
      });
      if (data.preview !== "off") {
        refreshPreview = startPreview({ mode: data.preview, files: data.files, values: vars.values, pageUrl, variants }).refresh;
      }
      refreshRequest = startResult({ files: data.files, outputUrl: `${base}output/`, variants, requests: data.runner, errorRule: data.errorRule, vars }).refreshRequest;

      // Clicker keys pressed while the preview has focus.
      addEventListener("message", (event) => {
        if (event.origin !== location.origin || event.data?.type !== "ics:step-key") return;
        const delta = keyToDelta(String(event.data.key));
        if (delta) engine.step(delta);
      });
    </script>
  </body>
</html>
