---
import { Content, files, frontmatter } from "virtual:interactive-code-scroll/tutorial";
import Step from "../components/Step.astro";
import VarField from "../components/VarField.astro";
import { readTutorialConfig } from "../frontmatter.ts";
import { highlight } from "../highlight.ts";
import { parseSource } from "../markers.ts";
import { PREVIEW_ENTRY } from "../preview/build-html.ts";
import "../styles/tutorial.css";

const config = readTutorialConfig(frontmatter);
if (config.preview !== "off" && !files.some((f) => f.path === PREVIEW_ENTRY)) {
  throw new Error(`tutorial.mdx frontmatter: preview "${config.preview}" needs code/${PREVIEW_ENTRY} (or set preview: off)`);
}
const parsed = files.map((f) => ({ path: f.path, parsed: parseSource(f.source, `code/${f.path}`) }));
const panes = await Promise.all(parsed.map(async (f) => ({ path: f.path, html: await highlight(f.parsed, f.path) })));
const withIframe = config.preview === "iframe" || config.preview === "both";
const withTab = config.preview === "tab" || config.preview === "both";
// Escape "<" so embedded code containing </script> cannot close the data block.
const clientData = JSON.stringify({ title: config.title, preview: config.preview, files: parsed }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.title}</title>
  </head>
  <body data-preview={config.preview} data-theme={config.theme}>
    <script is:inline>
      // Before first paint: avoid a flash of the wrong theme. Mirrors client/layout-values.ts.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("ics:theme");
        } catch (e) {}
        var choice = stored === "light" || stored === "dark" ? stored : document.body.dataset.theme;
        var dark = choice === "dark" || (choice !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.body.className = dark ? "calcite-mode-dark" : "calcite-mode-light";
      })();
    </script>
    <calcite-navigation class="app-header">
      <calcite-action slot="navigation-action" id="docs-toggle" icon="chevrons-left" text="Hide explanations" />
      {/* The page's h1: tutorial.mdx should not repeat the title. */}
      <calcite-navigation-logo slot="logo" heading={config.title} heading-level="1" />
      <div slot="content-end" class="header-actions">
        <span id="step-count" aria-live="polite"></span>
        <calcite-action id="present-toggle" icon="presentation" text="Present" />
        <calcite-action id="theme-toggle" icon="moon" text="Toggle theme" />
      </div>
      <calcite-progress slot="progress" id="progress-bar" value="0" label="Tutorial progress" />
    </calcite-navigation>
    <div class="layout">
      <main class="docs">
        <Content components={{ Step, VarField }} />
      </main>
      <div
        class="splitter"
        role="separator"
        tabindex="0"
        aria-orientation="vertical"
        aria-label="Resize panels"
        aria-valuemin="20"
        aria-valuemax="70"
        data-own-keys
      >
      </div>
      <aside class="right">
        <div class="code-panel">
          <div class="panel-header">
            <calcite-tab-nav>
              {
                panes.map((p, i) => (
                  <calcite-tab-title data-file={p.path} selected={i === 0} icon-start="file-code">
                    {p.path}
                  </calcite-tab-title>
                ))
              }
            </calcite-tab-nav>
            <calcite-action id="copy-file" icon="copy-to-clipboard" text="Copy file" />
            <calcite-action id="download-file" icon="download" text="Download file" />
            <calcite-action id="download-zip" icon="file-zip" text="Download project (ZIP)" />
          </div>
          {panes.map((p, i) => <div class="code" data-file={p.path} hidden={i !== 0} set:html={p.html} />)}
        </div>
        <div class="media-panel" hidden></div>
        {
          config.preview !== "off" && (
            <section class="preview" aria-label="Preview">
              <div class="panel-header">
                {withIframe ? (
                  <calcite-action id="preview-toggle" icon="chevron-down" text="Preview" text-enabled />
                ) : (
                  <span class="panel-title">Preview</span>
                )}
                {withIframe && <calcite-action id="preview-run" icon="refresh" text="Run" text-enabled />}
                {withTab && <calcite-action id="preview-open" icon="launch" text="Open in new tab" text-enabled />}
              </div>
              {withIframe && (
                <div class="preview-frame">
                  {/* Same origin is required: the SDK's OAuth callback talks to window.opener. */}
                  <iframe title="Preview" sandbox="allow-scripts allow-popups allow-forms allow-same-origin allow-modals" />
                </div>
              )}
            </section>
          )
        }
      </aside>
    </div>
    <script type="application/json" id="ics-data" set:html={clientData} />
    <script>
      import "../client/calcite.ts";
      import type { ParsedSource } from "../markers.ts";
      import { keyToDelta } from "../client/navigation.ts";
      import { startTooltips } from "../client/actions.ts";
      import { startDownloads } from "../client/downloads.ts";
      import { startLayout } from "../client/layout.ts";
      import { startPresentation } from "../client/presentation.ts";
      import { startPreview } from "../client/preview.ts";
      import { startStepEngine } from "../client/steps.ts";
      import { startVars } from "../client/vars.ts";

      const data = JSON.parse(document.querySelector("#ics-data")!.textContent!) as {
        title: string;
        preview: "off" | "iframe" | "tab" | "both";
        files: { path: string; parsed: ParsedSource }[];
      };

      startTooltips();
      startLayout();
      startPresentation();
      const engine = startStepEngine();
      let refreshPreview = () => {};
      const vars = startVars(() => refreshPreview());
      startDownloads({ files: data.files, values: vars.values, title: data.title });
      if (data.preview !== "off") {
        const pageUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}preview/`;
        refreshPreview = startPreview({ mode: data.preview, files: data.files, values: vars.values, pageUrl }).refresh;
      }

      // Clicker keys pressed while the preview has focus.
      addEventListener("message", (event) => {
        if (event.origin !== location.origin || event.data?.type !== "ics:step-key") return;
        const delta = keyToDelta(String(event.data.key));
        if (delta) engine.step(delta);
      });
    </script>
  </body>
</html>
