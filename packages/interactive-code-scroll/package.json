{
  "name": "interactive-code-scroll",
  "version": "0.1.0-alpha.8",
  "description": "Build guided, interactive code tutorials from MDX and annotated source code.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hhkaos/interactive-code-scroll"
  },
  "type": "module",
  "bin": {
    "interactive-code-scroll": "dist/bin/interactive-code-scroll.mjs",
    "ics": "dist/bin/interactive-code-scroll.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./series": {
      "types": "./dist/series-public.d.ts",
      "default": "./dist/series-public.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@esri/calcite-components": "^5.1.2",
    "fflate": "^0.8.3",
    "satteri": "^0.10.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "astro": "7.3.5"
  },
  "peerDependencies": {
    "astro": "^7.3.5"
  }
}
